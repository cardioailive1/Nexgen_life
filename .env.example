# ─────────────────────────────────────────────────────────────────────────────
# NexGenLife — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://nexgenlife.onrender.com
FRONTEND_URL=https://nesgenlife.studio

# ── Database (Render PostgreSQL or external) ──────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/nexgenlife?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-this
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://bvwgqafekmfqpylsrteu.supabase.co
SUPABASE_KEY=sb_publishable_giKFkcglGwHs2ezDp0UsKQ_tmZ3QJis
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly

# ── OAuth2 — Google ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://nexgenlife.onrender.com/auth/google/callback

# ── Email (SMTP via Resend) ───────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your-resend-api-key
EMAIL_FROM=NexGenLife <noreply@nesgenlife.studio>
SUPPORT_EMAIL=support@corverxis.com

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
COOKIE_SECRET=your-cookie-secret-min-32-chars

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://nesgenlife.studio,https://nexgenlife.onrender.com

# ── SOC2 / Compliance ─────────────────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=2555
DATA_RETENTION_DAYS=2555
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
